<?xml version="1.0" encoding="UTF-8"?>
<configuration scan="true" scanPeriod="30 seconds">
    <!--
      Default Logback configuration
      - Logs to console with a concise pattern
      - Root level INFO (can be overridden with -Dlogging.level.root=DEBUG via variable substitution below)
      - Automatically reloads if this file changes (scan=true)

      To change log levels at runtime without editing this file, pass system properties, e.g.:
      java -DLOG_LEVEL_ROOT=DEBUG -jar app.jar
    -->

    <!-- Allow overriding levels via system properties -->
    <variable name="LOG_LEVEL_ROOT" value="${LOG_LEVEL_ROOT:-INFO}"/>

    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n</pattern>
            <immediateFlush>true</immediateFlush>
        </encoder>
    </appender>

    <!-- Example of a rolling file appender (disabled by default). Uncomment to enable.
    <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>logs/application.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
            <fileNamePattern>logs/application.%d{yyyy-MM-dd}.log.gz</fileNamePattern>
            <maxHistory>14</maxHistory>
            <totalSizeCap>1GB</totalSizeCap>
        </rollingPolicy>
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>
    -->

    <!-- Set specific package log levels here if needed
    <logger name="be.egelke.ehealth" level="DEBUG"/>
    -->

    <root level="${LOG_LEVEL_ROOT}">
        <appender-ref ref="CONSOLE"/>
        <!-- <appender-ref ref="FILE"/> -->
    </root>
</configuration>
